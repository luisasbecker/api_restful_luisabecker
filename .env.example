APP_ENV=development
POSTGRES_USER=task_api
POSTGRES_PASSWORD=replace-with-random-database-password
POSTGRES_DB=task_api
TEST_POSTGRES_USER=task_api_test
TEST_POSTGRES_PASSWORD=replace-with-different-random-password
TEST_POSTGRES_DB=task_api_test
DATABASE_URL=postgresql+psycopg://task_api:replace-with-random-database-password@127.0.0.1:5432/task_api
TEST_DATABASE_URL=postgresql+psycopg://task_api_test:replace-with-different-random-password@127.0.0.1:5433/task_api_test
JWT_SECRET=replace-with-random-secret-of-at-least-32-bytes
JWT_ISSUER=task-api
JWT_AUDIENCE=task-api-client
JWT_MINUTES=30
BOOTSTRAP_NAME=Administrador
BOOTSTRAP_EMAIL=admin@example.org
# BOOTSTRAP_PASSWORD e DEMO_PASSWORD: fornecer por ambiente ou prompt oculto.
